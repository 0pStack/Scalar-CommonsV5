{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    // The lifecycle tests index chain query results freely; they predate the
    // base's noUncheckedIndexedAccess and are not held to it.
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.ts"]
}
