{
  "name": "@scalar-commons/e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every test that needs a live Scalar Commons chain: pallet lifecycles, the faucet, indexer and explorer against a node, and the attacker-archetype runner. CI typechecks the package and runs only the archetype runner's offline unit tests.",
  "license": "Apache-2.0",
  "scripts": {
    "setup:sdk": "npm --prefix ../sdk run build",
    "pretypecheck": "npm run setup:sdk",
    "typecheck": "tsc -p tsconfig.json && tsc -p lifecycle/tsconfig.json",
    "pretest": "npm run setup:sdk",
    "test": "vitest run archetypes/ support/",
    "test:live": "vitest run --config vitest.live.config.ts lifecycle/ faucet/ indexer/ explorer/",
    "test:live:lifecycle": "vitest run --config vitest.live.config.ts lifecycle/",
    "test:live:faucet": "vitest run --config vitest.live.config.ts faucet/",
    "test:live:indexer": "vitest run --config vitest.live.config.ts indexer/",
    "test:live:explorer": "vitest run --config vitest.live.config.ts explorer/",
    "archetypes": "node archetypes/run.mjs"
  },
  "devDependencies": {
    "@polkadot/api": "^16.5.0",
    "@polkadot/keyring": "^14.0.0",
    "@polkadot/types": "^16.5.0",
    "@polkadot/util": "^14.0.0",
    "@polkadot/util-crypto": "^14.0.0",
    "@scalar-commons/sdk": "*",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
