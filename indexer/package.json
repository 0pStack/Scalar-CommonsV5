{
  "name": "@scalar-commons/indexer",
  "version": "0.1.0",
  "description": "Event indexer and versioned REST API for Scalar Commons. Subscribes to finalized blocks on a live node, persists blocks/extrinsics/events, and serves them over a 25-endpoint v1 REST surface.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "scripts": {
    "setup:sdk": "npm --prefix ../sdk run build",
    "prestart": "npm run setup:sdk",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "pretypecheck": "npm run setup:sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run setup:sdk",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/types": "^17.0.2",
    "@polkadot/types-codec": "^17.0.2",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@scalar-commons/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
