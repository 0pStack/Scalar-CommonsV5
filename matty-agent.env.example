# Settings for scripts/run-matty-agent.sh (beginner guide: README-MATTY.md).
#
# On Replit, add these in the Secrets tool, not in a file. Values are placeholders.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# Your agent's key: the 12 words `bash scripts/setup-matty-agent.sh` showed you once.
# SECRET. Never put the real value in any file.
AGENT_MNEMONIC=<the 12 words from setup>

# Your approval: the agent's own address (starts with 5), also shown by setup. Only an agent
# whose key matches this address will start, lock its 1 000 test-CMN stake and pay the
# 50 test-CMN registration fee. Not secret.
APPROVED_AGENT_ADDRESS=<your agent address, 5...>

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Name shown for your agent on chain (agents.updateMetadata). Default: matty-agent
AGENT_NAME=matty-agent
# Heartbeat every N blocks (6 s each). Default 600 (about an hour); the chain's grace period is 10 800.
HEARTBEAT_BLOCKS=600

# ── FIXED by the run script (listed so you know; setting them has no effect) ──
# SCALAR_WS=wss://rpc.scalarnet.io   the public testnet
# AGENT_MODE=provider                 buyer mode spends on other agents; not part of this onboarding
# STAKE_CMN=1000                      the testnet's minimum stake
# STATE_DIR=agent/state               the agent's log and memory (gitignored)
