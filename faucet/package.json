{
  "name": "@scalar-commons/faucet",
  "version": "0.1.0",
  "description": "Devnet CMN faucet for Scalar Commons. Dispenses from a pre-funded devnet account — never a mint path. Rate limited per address and per IP.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.0",
    "@polkadot/keyring": "^14.0.0",
    "@polkadot/util": "^14.0.0",
    "@polkadot/util-crypto": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
