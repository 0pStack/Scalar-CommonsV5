{
  "name": "@scalar-commons/faucet",
  "version": "0.1.0",
  "description": "Devnet CMN faucet for Scalar Commons. Dispenses from a pre-funded devnet account — never a mint path. Rate limited per address and per IP.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@polkadot/api": "^15.0.0",
    "@polkadot/keyring": "^13.0.0",
    "@polkadot/util": "^13.0.0",
    "@polkadot/util-crypto": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
