# scalar-agent environment — copy to ~/.config/scalar-agent/agent.env (mode 0600).
# Every value here is read by src/config.ts; anything else is ignored.

# Endpoint. The public RPC works; your own node's loopback RPC is better if you run one.
SCALAR_WS=wss://rpc.scalarnet.io

# PATH to a file holding the agent's mnemonic (chmod 600). The seed itself is never
# accepted from the environment — SCALAR_SEED is rejected on purpose.
SCALAR_SEED_FILE=/home/agent/.config/scalar-agent/seed

# Stake locked by agents.register. agents.minStake is 1000 CMN on spec 306.
# Registration also burns agents.baseRegistrationFee (50 CMN).
AGENT_STAKE_CMN=1000

# Heartbeat every N blocks (6 s each). Must not exceed the 10 800-block grace period.
HEARTBEAT_EVERY_BLOCKS=600

# Capability ids to publish (agents.setCapability) and accept work for. Publishing
# needs an on-chain identity; the daemon sets one (display = AGENT_NAME) if missing,
# which reserves ~10 CMN + 0.1 CMN per byte.
AGENT_CAPABILITIES=
# Accept agreements that carry no capability id.
ACCEPT_UNCATEGORISED=true

# Confirm deliveries where THIS agent is the buyer, without checking the result.
# Leave false unless your worker verifies deliveries some other way.
AUTO_CONFIRM=false

# Claim emissions after each settled emissions era when something is pending.
CLAIM_REWARDS=true

AGENT_NAME=
AGENT_METADATA_URI=
EXPLORER_BASE=https://explorer.scalarnet.io
