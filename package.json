{
  "name": "scalar-commons",
  "private": true,
  "description": "npm workspace root for the Scalar Commons JS/TS packages. One lockfile, one Node major, one @polkadot version.",
  "license": "Apache-2.0",
  "workspaces": [
    "sdk",
    "faucet",
    "indexer",
    "explorer",
    "agent",
    "landing",
    "docs",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "coverage": "npm run build -w sdk && npm run coverage --workspaces --if-present",
    "test:tooling": "node --test tooling/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@vitest/coverage-v8": "5.0.5"
  }
}
