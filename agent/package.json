{
  "name": "@scalar-commons/reference-agent",
  "version": "0.1.0",
  "private": true,
  "description": "One-command reference worker for the Scalar Commons chain: register, heartbeat, accept, deliver, claim.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "setup:sdk": "npm --prefix ../sdk run build",
    "pretypecheck": "npm run setup:sdk",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "pretest": "npm run setup:sdk",
    "test": "vitest run",
    "messaging-demo": "node dist/message-demo.js",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/api": "^17.0.2",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@scalar-commons/sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
