{
  "name": "@scalar-commons/explorer",
  "version": "0.1.0",
  "description": "Web block explorer for Scalar Commons. Server-rendered block, extrinsic and account views read straight off a live node — every type shape comes from runtime metadata, none are hand-written.",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "scripts": {
    "setup:sdk": "npm --prefix ../sdk run build",
    "prebuild": "npm run setup:sdk",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "pretypecheck": "npm run setup:sdk",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "npm run setup:sdk",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@polkadot/api": "17.0.2",
    "@polkadot/types": "17.0.2",
    "@polkadot/types-codec": "17.0.2",
    "@polkadot/util": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "@scalar-commons/sdk": "*"
  },
  "devDependencies": {
    "@polkadot/keyring": "^14.0.3",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
