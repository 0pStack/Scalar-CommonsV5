{
  "name": "@scalar-commons/explorer",
  "version": "0.1.0",
  "description": "Web block explorer for Scalar Commons. Server-rendered block, extrinsic and account views read straight off a live node — every type shape comes from runtime metadata, none are hand-written.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@polkadot/api": "16.5.6",
    "@polkadot/types": "16.5.6",
    "@polkadot/types-codec": "16.5.6",
    "@polkadot/util": "^14.0.0",
    "@polkadot/util-crypto": "^14.0.0"
  },
  "devDependencies": {
    "@polkadot/keyring": "^14.0.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
