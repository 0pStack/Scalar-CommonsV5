# ============================================================================
#  THE SUBSTITUTION POINT — this is the ONLY file you edit to set the domain.
# ============================================================================
#
# Every `<DOMAIN>` placeholder in nginx/*.conf.template is replaced with the
# value below by render-config.sh. Do not hand-edit the templates.
#
# Set this to the apex domain you control. The install provisions five names:
#
#     <DOMAIN>            landing (/) + docs (/docs)
#     rpc.<DOMAIN>        wss -> 127.0.0.1:9944
#     api.<DOMAIN>        https -> 127.0.0.1:8080   (indexer)
#     explorer.<DOMAIN>   https -> 127.0.0.1:8081
#     faucet.<DOMAIN>     https -> 127.0.0.1:8082
#
# All five must already resolve (A/AAAA) to this host before you run certbot.

DOMAIN=example.com

# Absolute paths to the built static output. See INSTALL.md step 5 for how
# these are produced; the docs dist MUST be built with base '/docs/'.
LANDING_DIST=/home/dev/scalar-commons-v4/landing/dist
DOCS_DIST=/home/dev/scalar-commons-v4/docs/.vitepress/dist

# Webroot used only for the ACME http-01 challenge.
ACME_WEBROOT=/var/www/acme
