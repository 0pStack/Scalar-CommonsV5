# Scalar Commons indexer — operator overrides.
# Installed to ~/.config/scalar-commons/indexer.env (0600) by install.sh.
# Anything set here overrides the unit's Environment= lines, because the unit
# reads this file after them. Commented-out lines show the effective default:
# the unit's, where it sets one, otherwise the indexer's in-code default.

# REST API bind address. Loopback only: the indexer has no authentication and
# no rate limit, so exposing it means exposing an unmetered query surface.
# Put a reverse proxy in front of it before changing this.
#INDEXER_HOST=127.0.0.1
#INDEXER_PORT=8080

# Node to follow. alice is the archive node, so she is the one with the history.
#INDEXER_RPC_URL=ws://127.0.0.1:9944

# SQLite index. Absolute, because the unit's WorkingDirectory is the repo
# checkout and the index is state, not source. Spell the home directory out —
# %h is a systemd unit specifier and means nothing inside an env file.
#INDEXER_DB=/home/dev/scalar-products/indexer/indexer.sqlite

# Finalized blocks to backfill at startup. The indexer is a follower, not an
# archive: it catches up over a bounded window so a restart stays cheap.
#INDEXER_BACKFILL_DEPTH=256
