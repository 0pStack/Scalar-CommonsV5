# Scalar Commons explorer — operator overrides.
# Installed to ~/.config/scalar-commons/explorer.env (0600) by install.sh.
# Every value here overrides the matching Environment= line in
# scalar-explorer.service. Commented-out lines document the unit's default.

# Web UI bind address. Loopback only: the explorer renders whatever the node
# will answer, so a public bind is a public RPC by proxy. See
# deploy/README.md "Public RPC — deliberately not enabled yet".
#EXPLORER_HOST=127.0.0.1
#EXPLORER_PORT=8081

# Node to read from. Type shapes come from this node's runtime metadata, so
# pointing it at a node running a different spec_version changes what renders.
#EXPLORER_RPC_ENDPOINT=ws://127.0.0.1:9944
