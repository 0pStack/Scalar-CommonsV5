[Unit]
Description=Scalar Commons devnet validator — bob
Documentation=file:///home/dev/scalar-commons-v4/deploy/README.md
After=network-online.target scalar-alice.service
Wants=network-online.target
PartOf=scalar-devnet.target

[Service]
Type=exec
WorkingDirectory=%h
# Only alice is given as a bootnode. Authority discovery (ROUND5) resolves
# charlie's address over the DHT from there — bob is never told about charlie.
# No RPC is exposed on this node.
ExecStart=/home/dev/scalar-commons-v4/target/release/scalar-node \
    --chain /home/dev/scalar-commons-v4/deploy/scalar-local-raw.json \
    --base-path %h/scalar-testnet/bob \
    --name scalar-bob \
    --validator \
    --bob \
    --node-key-file %h/scalar-testnet/bob/node-key \
    --port 30334 \
    --rpc-port 9945 \
    --rpc-methods safe \
    --rpc-rate-limit 300 \
    --rpc-max-connections 100 \
    --rpc-max-subscriptions-per-connection 64 \
    --rpc-max-batch-request-len 16 \
    --rpc-max-request-size 10 \
    --rpc-message-buffer-capacity-per-connection 32 \
    --prometheus-port 9616 \
    --bootnodes /ip4/127.0.0.1/tcp/30333/p2p/12D3KooWEyoppNCUx8Yx66oV9fJnriXwCcXwDDUA2kj6vnc6iDEp
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scalar-bob

[Install]
WantedBy=scalar-devnet.target
