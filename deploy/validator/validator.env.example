# scalar-validator environment — install to ~/.config/scalar-validator/validator.env, mode 0600.
# Read by deploy/validator/scalar-validator.service. See docs/guide/run-a-validator.md.

# The node binary: the release download (verified with sha256sum -c) or your own build.
NODE_BIN=/home/validator/scalar/scalar-node

# Raw chain spec downloaded from https://scalarnet.io/docs/chainspec.json.
# It carries the five public bootnodes, so no --bootnodes flag is needed.
CHAIN_SPEC=/home/validator/scalar/chainspec.json

# Database, keystore and network key. Keep it; deleting it deletes your session keys.
BASE_PATH=/home/validator/scalar/base

# Shown in telemetry-free peer lists and logs. Pick your own.
NODE_NAME=my-scalar-validator

# p2p: the ONLY port that must be reachable from the internet (TCP inbound).
P2P_PORT=30333

# JSON-RPC, bound to 127.0.0.1 only. Never forward or expose it.
RPC_PORT=9944

# `safe` in normal operation. Set to `unsafe` ONLY for the one-off
# author_rotateKeys call on loopback, then set it back and restart.
RPC_METHODS=safe

# Prometheus metrics on 127.0.0.1.
PROMETHEUS_PORT=9615

# Anything else, e.g. `--no-telemetry` (the node sends none unless configured,
# but it costs nothing to be explicit).
EXTRA_ARGS=--no-telemetry
